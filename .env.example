# Copia este archivo a .env.local y completa con los datos de tu proyecto
# Supabase (Configuración del proyecto > API). VITE_SUPABASE_ANON_KEY es la
# llave pública (anon/public) — nunca pongas aquí la service_role key.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
